# Activate production profile
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL containers
POSTGRES_AUTH_DB=auth_db
POSTGRES_AUTH_USER=auth_user
POSTGRES_AUTH_PASSWORD=change-me-auth-password

POSTGRES_CALENDAR_DB=calendar_db
POSTGRES_CALENDAR_USER=calendar_user
POSTGRES_CALENDAR_PASSWORD=change-me-calendar-password

# Auth Service
AUTH_DB_URL=jdbc:postgresql://postgres-auth:5432/auth_db
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=change-me-auth-password
JWT_SECRET=change-me-long-random-secret
JWT_ACCESS_TOKEN_SECONDS=900

# Calendar Service
CALENDAR_DB_URL=jdbc:postgresql://postgres-calendar:5432/calendar_db
CALENDAR_DB_USERNAME=calendar_user
CALENDAR_DB_PASSWORD=change-me-calendar-password

# API Gateway
AUTH_SERVICE_URL=http://auth-service:8081
CALENDAR_SERVICE_URL=http://calendar-service:8082