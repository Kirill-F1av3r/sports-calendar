# Activate production profile
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL containers
POSTGRES_AUTH_DB=auth_db
POSTGRES_AUTH_USER=auth_user
POSTGRES_AUTH_PASSWORD=change-me-auth-password

POSTGRES_CALENDAR_DB=calendar_db
POSTGRES_CALENDAR_USER=calendar_user
POSTGRES_CALENDAR_PASSWORD=change-me-calendar-password

POSTGRES_EXPORT_DB=export_db
POSTGRES_EXPORT_USER=export_user
POSTGRES_EXPORT_PASSWORD=change-me-export-password

POSTGRES_INTEGRATION_DB=integration_db
POSTGRES_INTEGRATION_USER=integration_user
POSTGRES_INTEGRATION_PASSWORD=change-me-integration-password

# Auth Service
AUTH_DB_URL=jdbc:postgresql://postgres-auth:5432/auth_db
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=change-me-auth-password
JWT_SECRET=change-me-long-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_SECONDS=900
JWT_REFRESH_TOKEN_SECONDS=2592000
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE=Lax

# Calendar Service
CALENDAR_DB_URL=jdbc:postgresql://postgres-calendar:5432/calendar_db
CALENDAR_DB_USERNAME=calendar_user
CALENDAR_DB_PASSWORD=change-me-calendar-password

# Export Service
EXPORT_DB_URL=jdbc:postgresql://postgres-export:5432/export_db
EXPORT_DB_USERNAME=export_user
EXPORT_DB_PASSWORD=change-me-export-password
EXPORT_SERVICE_URL=http://export-service:8083
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
EXPORT_WORKER_GROUP_ID=export-worker-service

# Integration Service
INTEGRATION_DB_URL=jdbc:postgresql://postgres-integration:5432/integration_db
INTEGRATION_DB_USERNAME=integration_user
INTEGRATION_DB_PASSWORD=change-me-integration-password
INTEGRATION_SERVICE_URL=http://integration-service:8085
INTEGRATION_TOKEN_ENCRYPTION_SECRET=change-me-long-random-integration-secret-32-bytes
GOOGLE_OAUTH_CLIENT_ID=change-me-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=change-me-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/integrations/google/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.file

# API Gateway
AUTH_SERVICE_URL=http://auth-service:8081
CALENDAR_SERVICE_URL=http://calendar-service:8082
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8080
